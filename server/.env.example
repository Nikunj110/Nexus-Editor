# =============================================================================
# Nexus Editor — Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# -----------------------------------------------------------------------------
# OPTION A: DOCKER CONFIGURATION (Local Development)
# -----------------------------------------------------------------------------
# Use these values if running Postgres and Redis locally via docker-compose.yml
# DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/sync_db"
# REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# OPTION B: CLOUD / MANAGED HOSTING
# -----------------------------------------------------------------------------
# Use these if you prefer managed services (e.g. Neon, Aiven, Upstash, etc.)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
REDIS_URL="rediss://<user>:<password>@<host>:<port>"

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=3001

# -----------------------------------------------------------------------------
# CODE EXECUTION (Docker-based)
# -----------------------------------------------------------------------------
# Timeout in milliseconds for code execution (default: 10 seconds)
DOCKER_EXECUTION_TIMEOUT=10000

# Memory limit for each execution container (default: 128MB)
DOCKER_MEMORY_LIMIT=128m
