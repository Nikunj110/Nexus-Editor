# -----------------------------------------------------------------------------
# DOCKER CONFIGURATION (Default)
# -----------------------------------------------------------------------------
# Use these values if you are running the Postgres and Redis databases locally 
# via the provided docker-compose.yml file.
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/sync_db"
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# CLOUD / MANAGED HOSTING CONFIGURATION
# -----------------------------------------------------------------------------
# If you are NOT using Docker and prefer to use managed services (e.g. Neon, Aiven, Upstash),
# comment out the Docker URLs above and uncomment/replace the URLs below with your own:
# DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
# REDIS_URL="rediss://<user>:<password>@<host>:<port>"

PORT=3001
